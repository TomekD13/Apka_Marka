# Konfiguracja hostingu jestnadzieja.adwent.pl (LiteSpeed czyta .htaccess jak Apache).

<IfModule mod_rewrite.c>
  RewriteEngine On

  # W razie omylkowego wgrania katalogu Git nie udostepniamy jego historii.
  RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]

  # PWA i service worker wymagaja bezpiecznego polaczenia.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Beta zostala zdjeta z serwera 2026-10-04 (zyje na GitHub Pages) - stare linki
  # i zainstalowana beta trafiaja na strone glowna.
  RewriteRule ^beta(/.*)?$ /pl/ [R=301,L]

  # >>> blokada nagran i grafik przed data materialu (generuje tools/extract_edu.py - nie edytuj recznie)
  RewriteCond %{TIME} <20261026100000
  RewriteRule ^(audio/edu/013\.mp3|media/edu/013[a-z]?(\.jpg|_[md]\.webp))$ - [F,L]
  # <<< blokada

  # Brakujacy plik tresci pozostaje bledem 404, a nie strona HTML.
  RewriteRule ^content/ - [L]

  # Trasy aplikacji React, np. /pl/biblia/Gen/1.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

AddType application/manifest+json .webmanifest
AddType application/json .json
AddType image/webp .webp
AddType image/svg+xml .svg

# LiteSpeed na tym hostingu ignoruje AddType dla rozszerzenia .webmanifest.
# Wydanie korzysta z manifest.json, ale ta reguła chroni również stary adres.
<Files "manifest.webmanifest">
  ForceType application/manifest+json
</Files>

# Samsung Internet jest bardziej rygorystyczny od Chrome przy instalowaniu PWA:
# plik z manifestem powinien mieÄ‡ oficjalny typ MIME manifestu, a nie ogÃ³lne JSON.
<Files "manifest.json">
  ForceType application/manifest+json
</Files>

<IfModule mod_headers.c>
  # Naglowki bezpieczenstwa (test z 2026-10-02). CSP swiadomie brak - wymaga osobnego
  # sprawdzenia z logowaniem Google i YouTube.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Osadzanie w ramce (2026-10-16): hosting dokleja X-Frame-Options: SAMEORIGIN, co blokuje
  # aplikacje osadzona na stronie glownej misja.adwent.pl. Zdejmujemy go i pozwalamy tylko
  # tej domenie. CSP zawiera wylacznie frame-ancestors - nie ogranicza skryptow, Google ani YouTube.
  Header always unset X-Frame-Options
  Header unset X-Frame-Options
  Header always set Content-Security-Policy "frame-ancestors 'self' https://misja.adwent.pl"

  # Pliki wskazujace aktualna wersje aplikacji zawsze sprawdzamy ponownie.
  <FilesMatch "(sw\.js|index\.html|manifest\.(webmanifest|json)|registerSW\.js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # Nagrania lektorskie tylko strumieniowo (decyzja autora 2026-10-09): telefon nie trzyma
  # ich w pamieci podrecznej, wiec setki odcinkow nie zapchaja mu miejsca. Przewijanie
  # dziala dalej - przegladarka pobiera fragmenty (Range), service worker ich nie dotyka.
  <FilesMatch "\.mp3$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Grafiki Czlowieka Nadziei (decyzja autora 2026-10-15): miniatury i podglady moga polezec
  # w pamieci przegladarki tydzien (podmiana pliku zmienia adres ?v=), pelna grafika do
  # udostepnienia nie jest zapisywana - kolejne lekcje nie dociazaja telefonu.
  <FilesMatch "^[0-9]{3}[a-z]_(m|d)\.webp$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "^[0-9]{3}[a-z]\.jpg$">
    Header set Cache-Control "no-store"
  </FilesMatch>
  # Bundle z hashem moze pozostac w cache, bo nowy build dostaje nowa nazwe.
  <FilesMatch "^(?!sw\.js$|registerSW\.js$).*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
